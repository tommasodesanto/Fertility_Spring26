+def verify_continuation_initial(continuation, record, signatures, tolerance):
+    """Called inside the first normal callback, before the next root update."""
+    def values(v):return v.tolist() if hasattr(v,'tolist') else v
+    old=continuation['prior_final']
+    if record['evaluation']!=1 or record['phase']!='initial' or not record['mapping_valid']:
+        raise RuntimeError('Continuation first callback is not a valid fresh initial mapping')
+    for name in ('prices','fiscal_values'):
+        if values(record[name])!=values(old[name]):
+            raise RuntimeError('Continuation initial coordinates changed before fresh evaluation')
+    gaps={}
+    for name in ('market_residual','fiscal_residual'):
+        left,right=values(record[name]),values(old[name])
+        if len(left)!=len(right) or not left:
+            raise RuntimeError('Continuation initial residual dimensions changed')
+        differences=[abs(a-b) for a,b in zip(left,right)]
+        if any(not math.isfinite(a) or not math.isfinite(b) for a,b in zip(left,right)) or max(differences)>tolerance:
+            raise RuntimeError('Continuation initial mapping failed prior residual reproduction')
+        gaps[name]=max(differences)
+    if signatures!=continuation['prior_signatures']:
+        raise RuntimeError('Continuation initial policy/distribution/fiscal signatures changed')
+    return dict(verified=True,initial_mapping_counts_in_budget=True,residual_max_abs=gaps)
