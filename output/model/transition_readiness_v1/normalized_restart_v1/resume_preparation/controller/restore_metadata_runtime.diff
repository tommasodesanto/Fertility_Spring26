+def compare_saved_normalized_reference(handoff,reference,saved):
+    """Read-only exact saved-report comparison; only declared reference roles differ."""
+    require(normalized_housing_contract(handoff),'Saved normalized comparison requires explicit contract')
+    reference,saved=Path(reference),Path(saved)
+    def table(folder,name):
+        with (folder/name).open(newline='') as stream:return list(csv.DictReader(stream))
+    a,b=table(reference,'parameters.csv'),table(saved,'parameters.csv')
+    require(len(a)==len(b)==31,'Saved normalized parameter row count differs')
+    actual={row['parameter']:float(row['estimate']) for row in a}
+    for x,y in zip(a,b):
+        if x.get('parameter')=='H0':
+            require(y.get('parameter')=='H0' and x['status']=='derived calibrated housing supply coefficient at N0=1' and
+                y['status']=='fixed calibrated housing supply coefficient at N0=1','Saved normalized H0 status differs')
+            require({k:v for k,v in x.items() if k!='status'}=={k:v for k,v in y.items() if k!='status'},'Saved normalized H0 values differ')
+        else:require(x==y,'Saved normalized parameter fields differ')
+    a,b=table(reference,'target_fit.csv'),table(saved,'target_fit.csv')
+    require(len(a)==len(b)==14 and a==b,'Saved normalized full target table differs')
+    a,b=read(reference/'closure.json'),read(saved/'closure.json')
+    validate_normalized_housing_report(handoff,a,actual)
+    require(a.get('housing_supply_coefficient_role')=='derived calibrated coefficient at N0=1' and
+        a.get('standard_plot_supply_units')=='physical housing supply at normalized N0=1' and
+        b.get('standard_plot_supply_units')=='physical supply divided by endogenous household population',
+        'Saved normalized closure role metadata differs')
+    declared={'normalized_population','H0_derived','H0_bounds','housing_supply_coefficient_role'}
+    compared={k:v for k,v in a.items() if k not in declared}
+    compared['standard_plot_supply_units']=b['standard_plot_supply_units']
+    require(compared==b,'Saved normalized closure quantities or undeclared metadata differ')
+    aa={p.name:sha(p) for p in (reference/'standard_diagnostics').glob('*.png')}
+    bb={p.name:sha(p) for p in (saved/'standard_diagnostics').glob('*.png')}
+    require(len(aa)==17 and aa==bb,'Saved normalized standard plots differ')
+    return dict(status='saved_normalized_fixed_H0_reports_exact_passed',comparison_native_calls=0,target_rows=14,parameter_rows=31,
