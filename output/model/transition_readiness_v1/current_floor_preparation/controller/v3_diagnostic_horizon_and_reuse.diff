+        'Explicit authorized measurement replay manifest required')
+    old=json.loads(pinned(manifest['original_plan']).read_text())
+    for key in ('identity','target_contract','seed','gates','horizons','handoff','fit','initial_psi','psi_bound_ratios'):
+        require(old[key]==plan[key],'Reused measurement changed '+key)
+    require(manifest['original_controller_sha256']==old['source_files']['controller']['sha256'] and
+        old['source_files']['controller']['sha256']=='d011b35432706ceb011e605e3a4eaf7dcbb9cf95e76b5f3faa2ffb6875e7b8fb',
+        'Only authenticated V2 generator measurement replay supported')
+    require(set(old['source_files'])==set(plan['source_files']) and all(old['source_files'][k]==plan['source_files'][k]
+        for k in old['source_files'] if k!='controller'),'Reused measurement runtime/model source pins changed')
+    entry=next((e for e in manifest['cases'] if float(e['psi']).hex()==float(psi).hex()),None)
+    if entry is None:return None
