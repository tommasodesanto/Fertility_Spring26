+def reused_diagnostic_measurement(plan,psi):
+    """Explicit immutable measurement replay; cannot supply a final fitted state."""
+    item=plan.get('diagnostic_measurement_reuse')
+    if item is None:return None
+    require(plan['mode']=='diagnostic' and plan.get('diagnostic_horizon_tolerance_override') is not None,
+        'Measurement replay requires explicitly relaxed diagnostic mode')
