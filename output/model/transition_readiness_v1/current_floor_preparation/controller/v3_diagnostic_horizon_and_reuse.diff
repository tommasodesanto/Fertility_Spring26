+def diagnostic_horizon_override_allowed(plan):
+    override=plan.get('diagnostic_horizon_tolerance_override')
+    if override is None:return True
+    expected=dict(schema='diagnostic_horizon_tolerance_override_v1',
+        classification='exploratory relaxed finite-horizon comparison',macro_tolerance=.01,fertility_tolerance=.01,
+        original_macro_tolerance=.001,original_fertility_tolerance=.001,
+        state_gate_changes=False,terminal_gate_changes=False,root_gate_changes=False)
+    return bool(plan['mode']=='diagnostic' and override==expected and
+        all(override.get(k) is False for k in ('state_gate_changes','terminal_gate_changes','root_gate_changes')))
+
+
+def diagnostic_comparison_acceptance(strict,plan):
+    require(diagnostic_horizon_override_allowed(plan),'Invalid diagnostic horizon comparison override')
+    if plan.get('diagnostic_horizon_tolerance_override') is None:return strict
+    relaxed=copy.deepcopy(strict)
+    relaxed.update(passed=all(v<=.01 for v in strict['relative_gaps'].values()) and
+        max(strict['fertility_absolute_gaps'])<=.01,macro_tolerance=.01,fertility_tolerance=.01,
+        original_strict_comparison=copy.deepcopy(strict),original_strict_passed=strict['passed'],
+        diagnostic_horizon_tolerance_override=copy.deepcopy(plan['diagnostic_horizon_tolerance_override']),
+        classification='exploratory relaxed finite-horizon comparison; original strict status retained; full path uncertified')
+    return relaxed
+
