+def reused_native_point_binding(record,root,H,psi):
+    rows=record['rows'];point=root['final']
+    require(len(rows)==H and all(row['psi_child']==float(psi) and row['calendar_year']==2007+4*i
+        for i,row in enumerate(rows)), 'Reused native psi/calendar binding failed')
+    require([row['asset_price'] for row in rows]==point['prices'] and
+        [row['pension_period_units'] for row in rows]==point['fiscal_values'], 'Reused root price/pension binding failed')
+    for key in ('market_residual','fiscal_residual'):
+        a,b=record[key],point[key]
+        require(len(a)==len(b)==H and max(abs(x-y) for x,y in zip(a,b))<=GATES['final_reproduction_tolerance'],
+            'Reused root residual binding failed: '+key)
+
