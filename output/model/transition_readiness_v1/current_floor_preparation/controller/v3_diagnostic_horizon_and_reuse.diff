+            stationary['psi_child']==float(psi) and stationary['price']==endpoint['final']['prices'][0],
+            'Reused stationary certificate failed')
+        replies.append(dict(identity=plan['identity'],source_pins=plan['identity']['source_pins'],housing=record['housing'],
+            shock_contract=dict(psi=float(psi)),horizon=H,rows=record['rows'],fertility=record['fertility'],
+            terminal_pass=checkpoint['terminal_passes'][len(replies)]))
+    require(len(replies)==2,'Exactly two native horizon proofs required')
