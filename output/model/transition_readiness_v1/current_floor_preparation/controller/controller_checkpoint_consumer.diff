+def validate_consumer_compatibility(plan,preparation):
+    require(plan.get('prepared_consumer_compatibility') is not None,'Explicit approved generation/consumer compatibility pin required')
+    receipt=json.loads(pinned(plan['prepared_consumer_compatibility']).read_text())
+    require(receipt.get('schema')=='current_floor_prepared_consumer_compatibility_v1' and
+        receipt.get('compatibility_approved') is True and receipt.get('lead_review_accepted') is True,
+        'Compatibility requires explicit lead-reviewed approval')
+    require(receipt['original_preparation']==plan['prepared_native_inputs'],'Compatibility names another preparation')
+    require(json.loads(pinned(receipt['original_preparation']).read_text())==preparation,
+            'Compatibility must consume the unchanged original preparation bytes')
+    generator=preparation['source_files']['controller'];consumer=plan['source_files']['controller']
+    require(receipt['original_generator_controller']==generator and
+        generator['sha256']=='658859f10ec709d92f07bc599d3d36144c672827a99ffdd16bc4cee6892affef',
+        'Compatibility supports only the exact original 658 generator')
+    snapshot=pinned(receipt['original_generator_snapshot'])
+    require(sha(snapshot)==generator['sha256'],'Historical generator snapshot bytes differ')
+    current=pinned(receipt['consumer_controller'])
+    require(receipt['consumer_controller']==consumer and current.resolve()==Path(__file__).resolve() and sha(current)==sha(__file__),
+        'Approved consumer differs from the actually installed controller')
+    require(receipt['allowed_source_roles']==['controller'],'No other source-role override is permitted')
+    for role,item in preparation['source_files'].items():
+        if role!='controller':
+            require(item==plan['source_files'][role],'Non-controller source changed')
+            pinned(item)
+    audit=json.loads(pinned(receipt['reviewed_audit']).read_text());diff=pinned(receipt['reviewed_diff'])
+    require(audit['schema']=='controller_checkpoint_consumer_source_delta_audit_v1' and
+        audit.get('accepted_numerics_unchanged') is True and audit.get('lead_review_accepted') is True and
+        audit['original_preparation']==plan['prepared_native_inputs'] and audit['old_snapshot']==receipt['original_generator_snapshot'] and
+        audit['old_source']['sha256']==generator['sha256'] and audit['new_source']==consumer and audit['diff']==receipt['reviewed_diff'],
+        'Stale or unapproved reviewed source audit')
+    scopes=['output_checkpoint','explicit_generation_consumer_validation','stationary_gate_boolean_normalization']
+    require(audit['change_scopes']==scopes and receipt['change_scopes']==scopes,'Compatibility scope changed')
+    checks=compatibility_ast_checks(snapshot.read_text(),current.read_text())
+    require(all(checks.values()) and all(audit['checks'].get(k) is True for k in checks),
+        'Critical numerical AST or reviewed checks changed')
+    actual_diff=''.join(difflib.unified_diff(snapshot.read_text().splitlines(True),current.read_text().splitlines(True),
+        fromfile=audit['old_source']['path'],tofile=audit['new_source']['path']))
+    require(diff.read_text()==actual_diff,'Reviewed diff is stale or does not describe the installed consumer')
+    return receipt
 
 
