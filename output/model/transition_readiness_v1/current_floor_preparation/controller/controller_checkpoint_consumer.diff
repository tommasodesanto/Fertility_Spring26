+def stationary_mapping_valid(record):
+    """Interpret native audit receipts without truth-testing descriptive zeros."""
+    require(isinstance(record,dict) and isinstance(record.get('gates'),dict),'Native stationary audit record required')
+    gates=record['gates']
+    for key in ('household_budget','purchase','estate','policy_arrays','stationary_operator','fiscal_certificate'):
+        require(isinstance(gates.get(key),dict),'Native stationary audit geometry changed: '+key)
+    require(type(gates.get('housing_market_clearing_required')) is bool and
+        type(gates.get('feasibility_projection_mass')) in (float,int) and
+        math.isfinite(gates['feasibility_projection_mass']), 'Native stationary audit descriptive fields changed')
+    certificate=gates['fiscal_certificate']
+    require(type(certificate.get('marginal_gate')) is bool and type(certificate.get('fiscal_gate')) is bool and
+        certificate.get('marginal_tolerance')==1e-9 and certificate.get('fiscal_tolerance')==1e-6,
+        'Original native stationary marginal/fiscal certification required')
+    return bool(record.get('accounting_valid') is True and certificate['marginal_gate'] is True and
+        certificate['fiscal_gate'] is True and gates['feasibility_projection_mass']==0.)
