+def compatibility_ast_checks(old_text,new_text):
+    old,new=ast.parse(old_text),ast.parse(new_text)
+    def classes(tree):return {n.name:n for n in tree.body if isinstance(n,ast.ClassDef)}
+    def methods(node):return {n.name:n for n in node.body if isinstance(n,ast.FunctionDef)}
+    def same(x,y):return ast.dump(x,include_attributes=False)==ast.dump(y,include_attributes=False)
+    a,b=classes(old),classes(new);x,y=methods(a['Controller']),methods(b['Controller'])
+    old_native,new_native=methods(a['NativeAdapter']),methods(b['NativeAdapter'])
+    checks=dict(NativeAdapter_methods_except_endpoint_AST_identical=all(
+        name in new_native and same(node,new_native[name]) for name,node in old_native.items() if name!='_endpoint'))
+    endpoint=copy.deepcopy(old_native['_endpoint']);replacements=0
+    class NormalizeStationaryPredicate(ast.NodeTransformer):
+        def visit_Call(self,node):
+            nonlocal replacements
+            self.generic_visit(node)
+            if ast.unparse(node)=="all(record['gates'].values())":
+                replacements+=1
+                return ast.copy_location(ast.parse('stationary_mapping_valid(record)',mode='eval').body,node)
+            return node
+    endpoint=NormalizeStationaryPredicate().visit(endpoint)
+    checks['NativeAdapter_endpoint_only_stationary_valid_predicate_changed']=replacements==1 and same(endpoint,new_native['_endpoint'])
+    for name in ('__init__','remaining','progress','account','prepare'):
+        checks['Controller_'+name+'_AST_identical']=same(x[name],y[name])
+    def gates(tree):
+        return next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='GATES' for t in n.targets))
+    checks['GATES_AST_identical']=same(gates(old),gates(new))
+    old_functions={n.name:n for n in old.body if isinstance(n,ast.FunctionDef)}
+    new_functions={n.name:n for n in new.body if isinstance(n,ast.FunctionDef)}
+    checks['Original_global_functions_except_validate_preparation_AST_identical']=all(
+        name in new_functions and same(node,new_functions[name]) for name,node in old_functions.items() if name!='validate_preparation')
+    def critical_calls(node):
+        names={'self.runtime.evaluate','diagnostic_horizon_comparison','original.inner.compare_horizons','self.runtime.compare_2023','fitter.fit_one','fitter.fit_rows'}
+        return sorted(ast.dump(n,include_attributes=False) for n in ast.walk(node) if isinstance(n,ast.Call) and ast.unparse(n.func) in names)
+    for name in ('evaluate','run'):
+        checks['Controller_'+name+'_all_critical_numerical_calls_AST_identical']=critical_calls(x[name])==critical_calls(y[name])
+    return checks
