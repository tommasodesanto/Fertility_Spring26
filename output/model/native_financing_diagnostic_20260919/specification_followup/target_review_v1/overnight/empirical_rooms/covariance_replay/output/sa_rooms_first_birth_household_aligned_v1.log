. file write bfh "matrix_index,cohort_index,cohort,event_index,event,stata_inte
> raction_name,estimate,marginal_variance" _n

. forvalues i = 1/`n_interactions' {
  2.     local event_index = ceil(`i' / `ncohort')
  3.     local cohort_index = mod(`i' - 1, `ncohort') + 1
  4.     local cohort : word `cohort_index' of `cohortnames'
  5.     local event : word `event_index' of `eventnames'
  6.     local rawname : word `i' of `rawnames'
  7.     local beta = b_interact[`cohort_index', `event_index']
  8.     local beta_full = b_full[1, `i']
  9.     local vari = V_interact[`cohort_index', `event_index']
 10.     local vari_full = V_full[`i', `i']
 11.     assert abs(`beta' - `beta_full') <= 1e-14
 12.     assert abs(`vari' - `vari_full') <= 1e-14
 13.     local beta_export : display %24.17g `beta'
 14.     local vari_export : display %24.17g `vari'
 15.     file write bfh `"`i',`cohort_index',`cohort',`event_index',`event',`ra
> wname',`beta_export',`vari_export'"' _n
 16. }

