. restore

. 
. quietly levelsof first_child_year if !never_treated, local(cohorts)

. local interactions ""

. foreach l of varlist L*event F*event {
  2.     foreach g of local cohorts {
  3.         gen byte sa_`l'_`g' = (first_child_year==`g')*`l'
  4.         local interactions "`interactions' sa_`l'_`g'"
  5.     }
  6. }

. local alternative ""

. foreach v of local interactions {
  2.     if "`v'"!="sa_F1event_1986" local alternative "`alternative' `v'"
  3. }

. tempname summaries

. foreach specification in original reference {
  2.     local regressors "`interactions'"
  3.     if "`specification'"=="reference" local regressors "`alternative'"
  4.     di as result "REFERENCE_CHECK_START `specification'"
  5.     quietly reghdfe rooms `regressors' i.AGEREP i.EDUYEAR [pw=IW], ///
>         absorb(ID year) vce(cluster ID) residuals(residual_`specification')
  6.     local obs = e(N)
  7.     local clusters = e(N_clust)
  8.     local rss = e(rss)
  9.     gen byte sample_`specification'=e(sample)
 10.     if "`specification'"=="original" & "`mode'"=="full" {
 11.         assert `obs'==49457
 12.         assert `clusters'==4112
 13.     }
 14.     local maxdiff=0
 15.     if "`specification'"=="reference" {
 16.         assert sample_original==sample_reference
 17.         gen double fitted_difference=abs(residual_reference-residual_origi
> nal)
 18.         quietly summarize fitted_difference if sample_original, meanonly
 19.         local maxdiff=r(max)
 20.         assert `maxdiff'<2e-6
 21.     }
 22.     postfile `summaries' str12 specification double observations clusters 
> rss ///
>         max_fitted_difference using "`outdir'/fit_receipt_`specification'.dta
> ", replace
 23.     post `summaries' ("`specification'") (`obs') (`clusters') (`rss') (`ma
> xdiff')
 24.     postclose `summaries'
 25.     tempname coefficients
 26.     postfile `coefficients' int cohort str12 event double coefficient vari
> ance ///
>         byte explicit_reference using "`outdir'/coefficients_`specification'.
> dta", replace
 27.     foreach l of varlist L*event F*event {
 28.         foreach g of local cohorts {
 29.             if "`specification'"=="reference" & "`l'"=="F1event" & `g'==19
> 86 {
 30.                 post `coefficients' (`g') ("`l'") (0) (0) (1)
 31.             }
 32.             else {
 33.                 post `coefficients' (`g') ("`l'") (_b[sa_`l'_`g']) ///
>                     (_se[sa_`l'_`g']^2) (0)
 34.             }
 35.         }
 36.     }
 37.     postclose `coefficients'
 38.     preserve
 39.         use "`outdir'/fit_receipt_`specification'.dta", clear
 40.         export delimited using "`outdir'/fit_receipt_`specification'.csv",
>  replace
 41.     restore
 42.     preserve
 43.         use "`outdir'/coefficients_`specification'.dta", clear
 44.         export delimited using "`outdir'/coefficients_`specification'.csv"
> , replace
 45.     restore
 46.     preserve
 47.         keep if sample_`specification'
 48.         gen long one=1
 49.         collapse (sum) observations=one weight_sum=IW, by(first_child_year
>  K never_treated)
 50.         export delimited using "`outdir'/estimation_support_`specification
> '.csv", replace
 51.     restore
 52.     di as result "REFERENCE_CHECK_DONE `specification' obs=`obs' max_fitte
> d_difference=`maxdiff'"
 53. }
