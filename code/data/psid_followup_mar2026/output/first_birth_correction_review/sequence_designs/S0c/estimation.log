. do "audit_rooms_sequence.do" S0c "/scratch/td2248/projects/Fertility_Spring26
> _rooms_sequence_20260923/results/S0c"

. * One-change-at-a-time sequence from the author's original Sun-Abraham
. * specification (window design, corrected room dates) toward the August
. * household specification. Cumulative arms:
. *   S0  reproduction of window_aligned (baseline -3/-2, corrected dates)
. *   B21 S0 with a -2/-1 baseline window instead (sensitivity, not cumulative)
. *   S1  S0 + explicit comparison group: rows without a recorded first birth
. *       kept only for people whose reported child count is zero
. *   S2  S1 + women who are current reference persons or spouses
. *   S3  S2 + household unit: single-family-unit dwellings, one woman per
. *       household-year (reference person first)
. *   S4  S3 + first birth from the full biological-child history; known
. *       parents without birth timing dropped
. *   S5  S4 + year-specific non-room codes (9 / 99 / 98,99) set to missing
. *   S6  S5 + PSID longitudinal weights [pw=iw], iw>0
. *   S0c, B21c: S0 / B21 with the S5 non-room code cleaning applied
. *   S4a: S3 + biological first-birth history WITHOUT the first-birth-after-en
> try rule
. version 17.0

. args mode outdir

. timer clear 1

. timer on 1

. if "`mode'" == "toy" {
.     capture mkdir "`outdir'"
.     clear
.     set seed 23092026
.     set obs 8000
.     gen long ID = ceil(_n/40)
.     bysort ID: gen int year = 1979+_n
.     keep if year<=1997 | mod(year,2)==1
.     gen int f_c_y = 1985+3*mod(ID,7)
.     replace f_c_y = . if mod(ID,5)==0
.     gen double K = year-f_c_y
.     quietly summarize f_c_y
.     gen byte lastcohort = f_c_y==r(max)
.     gen byte AGEREP = 25+mod(ID,10)
.     gen byte EDUYEAR = 12+mod(ID,4)
.     gen double rooms = 4+ID/100+0.2*(K>=0 & !missing(K))+rnormal()
.     replace rooms = 99 if mod(_n,97)==0 & year>=1985 & year<=1993
.     sort ID year
.     by ID: gen double rooms_aligned = rooms[_n-1]
.     replace rooms = rooms_aligned
.     gen byte common_rooms = !missing(rooms,rooms_aligned)
.     gen double bio_first_year = f_c_y
.     replace bio_first_year = f_c_y+1 if mod(ID,13)==0 & !missing(f_c_y)
.     gen double relchirep_max = cond(missing(f_c_y), cond(mod(ID,10)==0,0,1), 
> 1)
.     replace relchirep_max = . if mod(ID,17)==0 & missing(f_c_y)
.     gen byte woman = mod(ID,2)==0
.     gen byte current = 1
.     gen double rel = 1+mod(ID,3)
.     gen double hhid = ceil(ID/2)
.     gen double fid = hhid
.     gen int n_current_fids = 1+(mod(hhid,9)==0)
.     gen double iw = 1+mod(ID,4)
.     replace iw = 0 if mod(ID,19)==0
.     tempfile toydata
.     save `toydata'
.     foreach arm in S0 B21 S1 S2 S3 S4 S5 S6 S0c B21c S4a {
  2.         use `toydata', clear
  3.         do "audit_rooms_sequence.do" `arm' "`outdir'/`arm'"
  4.     }
.     di "ROOMS_SEQUENCE_TOY_PASS"
.     exit
. }

. assert inlist("`mode'","S0","B21","S1","S2","S3","S4","S5","S6") | inlist("`m
> ode'","S0c","B21c","S4a")

. capture mkdir "`outdir'"

. local step = cond(substr("`mode'",1,3)=="B21", 0, real(substr("`mode'",2,1)))

. local clean_codes = `step' >= 5 | strpos("`mode'","c") > 0

. local entry_rule = `step' >= 4 & "`mode'" != "S4a"

. 
. * Base: observations complete under both date assignments; corrected dates.
. keep if common_rooms & !missing(AGEREP,EDUYEAR)
(2,508,687 observations deleted)

. replace rooms = rooms_aligned
(192,779 real changes made)

. local weightspec ""

. local baseline_lo -3

. local baseline_hi -2

. if substr("`mode'",1,3) == "B21" {
.     local baseline_lo -2
.     local baseline_hi -1
. }

. if `step' >= 1 {
.     drop if missing(f_c_y) & !(relchirep_max == 0)
. }

. if `step' >= 2 {
.     keep if woman & current & inlist(rel,1,2)
. }

. if `step' >= 3 {
.     keep if !missing(hhid) & hhid > 0 & !missing(fid) & fid > 0 & n_current_f
> ids == 1
.     gen byte priority = rel != 1
.     sort hhid year priority ID
.     by hhid year: keep if _n == 1
.     drop priority
.     isid hhid year
. }

. if `step' >= 4 {
.     replace f_c_y = bio_first_year
.     drop if missing(f_c_y) & !(relchirep_max == 0)
.     if `entry_rule' {
.         bysort ID: egen double year_entry = min(year)
.         drop if !missing(f_c_y) & f_c_y < year_entry
.         drop year_entry
.     }
.     replace K = year - f_c_y
.     quietly summarize f_c_y
.     replace lastcohort = f_c_y == r(max)
. }

. if `clean_codes' {
.     replace rooms = . if year <= 1984 & rooms == 9
(1,160 real changes made, 1,160 to missing)
.     replace rooms = . if inrange(year,1985,1993) & rooms == 99
(883 real changes made, 883 to missing)
.     replace rooms = . if year >= 1994 & inlist(rooms,98,99)
(2,516 real changes made, 2,516 to missing)
.     drop if missing(rooms)
(4,559 observations deleted)
. }

. if `step' >= 6 {
