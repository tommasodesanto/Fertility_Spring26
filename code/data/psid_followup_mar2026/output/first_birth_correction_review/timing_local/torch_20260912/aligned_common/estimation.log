. local difference = b[1,`p3']-b[1,`m1']

. local difference_se = sqrt(V[`p3',`p3']+V[`m1',`m1']-2*V[`p3',`m1'])

. assert !missing(`difference',`difference_se') & `difference_se'>0

. quietly summarize rooms if e(sample) & K==-2

. local premean = r(mean)

