. local ownsamp "own == 1 & value > 0 & !missing(value) & rooms > 0 & !missing(
> rooms)"

. foreach arm of local arms {
  2.     timer clear 2
  3.     timer on 2
  4.     use `base', clear
  5.     local basis = cond("`arm'" == "own_rep", "own", "rooms")
  6.     keep if current & !missing(`basis', AGEREP, EDUYEAR) & AGEREP >= 18
  7.     keep if !missing(iw) & iw > 0
  8.     gen double f_c_y = bio_first_year
  9.     drop if missing(f_c_y) & !(relchirep_max == 0)
 10.     drop if !missing(f_c_y) & f_c_y < year_entry_adult
 11.     gen byte control = missing(f_c_y) & relchirep_max == 0
 12.     gen byte hs_row = inlist(rel,1,2) & inrange(year - f_c_y, -3, -2)
 13.     bysort ID: egen byte hs_base = max(hs_row)
 14.     gen byte base_row = inrange(year - f_c_y, -3, -2)
 15.     bysort ID: egen byte has_base = max(base_row)
 16.     keep if control | (has_base & hs_base == 1)
 17.     drop hs_row hs_base base_row has_base
 18.     gen double K = year - f_c_y
 19.     if strpos("`arm'", "_preown") {
 20.         * Treated must own at every observed baseline (-3/-2) interview.
.         gen byte b_own = inrange(K,-3,-2) & own == 1
 21.         gen byte b_not = inrange(K,-3,-2) & own != 1
 22.         bysort ID: egen byte any_b_own = max(b_own)
 23.         bysort ID: egen byte any_b_not = max(b_not)
 24.         keep if control | (any_b_own & !any_b_not)
 25.         drop b_own b_not any_b_own any_b_not
 26.     }
 27.     gen double y = .
 28.     gen double lvl = .
 29.     local tc = 0
 30.     if "`arm'" == "own_rep" {
 31.         replace y = own
 32.         replace lvl = own
 33.         local def "owner; replication of v3 A2h_own"
 34.     }
 35.     if inlist("`arm'", "lnval", "lnval_preown") {
 36.         replace y = ln(value) if `ownsamp'
 37.         replace lvl = value if !missing(y)
 38.         local def "log real house value (2022 USD); owners"
 39.     }
 40.     if inlist("`arm'", "lnrooms_own", "lnrooms_preown") {
 41.         replace y = ln(rooms) if `ownsamp'
 42.         replace lvl = rooms if !missing(y)
 43.         local def "log rooms; owners (same rows as lnval)"
 44.     }
 45.     if inlist("`arm'", "lnvpr", "lnvpr_preown") {
 46.         replace y = ln(value / rooms) if `ownsamp'
 47.         replace lvl = value / rooms if !missing(y)
 48.         local def "log real house value per room; owners (same rows as lnv
> al)"
 49.     }
 50.     if "`arm'" == "anymort" {
 51.         replace y = mort > 0 if `ownsamp' & !missing(mort)
 52.         replace lvl = y
 53.         local def "any mortgage; owners; mortgage years only"
 54.     }
 55.     if "`arm'" == "lnmort" {
 56.         replace y = ln(mort) if `ownsamp' & mort > 0 & !missing(mort)
 57.         replace lvl = mort if !missing(y)
 58.         local def "log real mortgage principal; owners with a mortgage"
 59.     }
 60.     if "`arm'" == "ltv" {
 61.         quietly count if `ownsamp' & !missing(mort) & mort / value > 2
 62.         local tc = r(N)
 63.         replace y = min(mort / value, 2) if `ownsamp' & !missing(mort)
 64.         replace lvl = mort / value if !missing(y)
 65.         local def "mortgage / value, top-coded at 2; owners incl. zero mor
> tgage"
 66.     }
 67.     if "`arm'" == "interstate" {
 68.         replace y = interstate
 69.         replace lvl = interstate
 70.         local def "state differs from previous interview; all tenures"
 71.     }
 72.     if strpos("`arm'", "_preown") local def "`def'; treated owned at -3/-2
> "
 73.     keep if !missing(y)
 74.     * Cohort support: every treated cohort must be observed in the baselin
> e window.
.     gen byte in_reference = inrange(K,-3,-2)
 75.     bysort f_c_y: egen long reference_rows = total(in_reference)
 76.     gen byte unsupported = !missing(f_c_y) & control == 0 & reference_rows
>  == 0
 77.     quietly count if unsupported
 78.     local dropped = r(N)
 79.     drop if unsupported
 80.     drop in_reference reference_rows unsupported
 81.     gen byte Wleft = K <= -8 & !missing(K)
 82.     gen byte Wm2 = inrange(K,-7,-6)
 83.     gen byte Wm1 = inrange(K,-5,-4)
 84.     gen byte Wp1 = inrange(K,-1,0)
 85.     gen byte Wp2 = inrange(K,1,2)
 86.     gen byte Wp3 = inrange(K,3,4)
 87.     gen byte Wp4 = inrange(K,5,6)
 88.     gen byte Wp5 = inrange(K,7,8)
 89.     gen byte Wp6 = inrange(K,9,10)
 90.     gen byte Wright = K >= 11 & !missing(K)
 91.     local dummies Wleft Wm2 Wm1 Wp1 Wp2 Wp3 Wp4 Wp5 Wp6 Wright
 92.     di "ARM `arm': `def'"
 93.     capture noisily eventstudyinteract y `dummies' [pw=iw], ///
>         vce(cluster ID) absorb(ID year) cohort(f_c_y) control_cohort(control)
>  ///
>         covariates(i.AGEREP i.EDUYEAR)
 94.     local rc = _rc
 95.     timer off 2
 96.     quietly timer list 2
 97.     local secs = r(t2)
 98.     if `rc' {
 99.         di "ARM_FAIL `arm' rc=`rc'"
100.         post `S' ("`arm'") ("`def'") (`rc') (.) (.) (.) (.) (.) (.) (.) (.
> ) (.) (.) (`dropped') (`tc') (`secs')
101.         continue
102.     }
103.     matrix b = e(b_iw)
104.     matrix V = e(V_iw)
105.     local n = e(N)
106.     local clusters = e(N_clust)
107.     local names : colnames b
108.     forvalues i = 1/`=colsof(b)' {
109.         local w : word `i' of `names'
110.         local lo = cond("`w'"=="Wleft", ., cond("`w'"=="Wm2", -7, cond("`w
> '"=="Wm1", -5, cond("`w'"=="Wp1", -1, cond("`w'"=="Wp2", 1, cond("`w'"=="Wp3"
> , 3, cond("`w'"=="Wp4", 5, cond("`w'"=="Wp5", 7, cond("`w'"=="Wp6", 9, 11))))
> )))))
111.         local hi = cond("`w'"=="Wleft", -8, cond("`w'"=="Wright", ., `lo' 
> + 1))
112.         post `P' ("`arm'") ("`w'") (`lo') (`hi') (b[1,`i']) (sqrt(V[`i',`i
> ']))
113.     }
114.     local h = colnumb("b", "Wp3")
115.     quietly summarize y [aw=iw] if e(sample) & inrange(K,-3,-2)
116.     local rm = r(mean)
117.     quietly summarize lvl [aw=iw] if e(sample) & inrange(K,-3,-2)
118.     local rl = r(mean)
119.     quietly summarize y [aw=iw] if e(sample) & control
120.     local cm = r(mean)
121.     egen byte ctag = tag(ID) if e(sample) & control
122.     quietly count if ctag
123.     local cids = r(N)
124.     egen byte ttag = tag(ID) if e(sample) & !control & !missing(f_c_y)
125.     quietly count if ttag
126.     local tids = r(N)
127.     post `S' ("`arm'") ("`def'") (0) (`n') (`clusters') (`tids') (`cids') 
> (`rm') (`rl') (`cm') (b[1,`h']) (sqrt(V[`h',`h'])) (`dropped') (`tc') (`secs'
> )
128.     di "ARM_PASS `arm' N=`n' Wp3=" b[1,`h'] " se=" sqrt(V[`h',`h'])
129. }
