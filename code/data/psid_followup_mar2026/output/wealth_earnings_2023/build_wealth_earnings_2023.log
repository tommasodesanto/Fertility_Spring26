. program define postratio
  1.     args handle window source cond
  2.     quietly count if `cond'
  3.     local N = r(N)
  4.     quietly count if `cond' & AGEREP <= 65
  5.     local Ne = r(N)
  6.     quietly summarize wnw if `cond'
  7.     local a = r(sum)
  8.     quietly summarize wnwc if `cond'
  9.     local b = r(sum)
 10.     quietly summarize wearn if `cond'
 11.     local d = r(sum)
 12.     quietly summarize wnw_pce if `cond'
 13.     local a2 = r(sum)
 14.     quietly summarize wnwc_pce if `cond'
 15.     local b2 = r(sum)
 16.     quietly summarize wearn_pce if `cond'
 17.     local d2 = r(sum)
 18.     post `handle' ("`window'") ("`source'") (`N') (`Ne') (`a'/`d') (`b'/`d
> ') (`a2'/`d2') (`b2'/`d2')
 19. end

. foreach y in 2013 2015 2017 2019 {
  2.     postratio `R' "`y'" "shelf" "src == 0 & year == `y'"
  3. }

. postratio `R' "2019" "rebuilt" "src == 2 & year == 2019"

. foreach y in 2021 2023 {
  2.     postratio `R' "`y'" "rebuilt" "src == 1 & year == `y'"
  3. }

. postratio `R' "pooled_2017_2019" "shelf" "src == 0 & inlist(year, 2017, 2019)
> "

. postratio `R' "pooled_2015_2019" "shelf" "src == 0 & inlist(year, 2015, 2017,
>  2019)"

. postratio `R' "pooled_2019_2021" "mixed" "(src == 0 & year == 2019) | (src ==
>  1 & year == 2021)"

. postratio `R' "pooled_2021_2023" "rebuilt" "src == 1 & inlist(year, 2021, 202
> 3)"

. postratio `R' "pooled_2019_2023" "mixed" "(src == 0 & year == 2019) | (src ==
>  1 & inlist(year, 2021, 2023))"

. postclose `R'

. use "`out'/ratios.dta", clear

. format ratio_orig ratio_narrow %9.4f

