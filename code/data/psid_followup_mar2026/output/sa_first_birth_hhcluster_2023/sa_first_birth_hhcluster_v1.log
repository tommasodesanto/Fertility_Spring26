. do ../../sa_first_birth_hhcluster_v1.do /private/tmp/claude-501/-Users-tommas
> odesanto-Desktop-Projects-Fertility-Fertility-Spring26/5d7c0112-2a2b-45f4-ab6
> e-9684dff40b7f/scratchpad/hhc2023/augmented.dta /Users/tommasodesanto/Desktop
> /Projects/Fertility/Fertility_Spring26/code/data/psid_followup_mar2026/output
> /sa_first_birth_hhcluster_2023 

. * First-birth A2h event study with standard errors clustered by household (Oc
> t 19, 2026).
. * Point estimates are those of the person-clustered runs; only vce changes.
. *   full support: sa_rooms_first_birth_v2.do A2h logic (rooms) and the v3 arm
> s
. *     A2h_own, A2h_moved (A2h filter on each outcome's non-missing rows)
. *   common support (rooms_cs): sa_first_birth_model_bridge.do, original clock
. * Household cluster: PSID HHID is wave-specific, so a cluster is a (year, HHI
> D)
. * pair. Treated adults take the household of their earliest reference-window
. * (-3/-2) interview at which they are reference person or spouse; never-paren
> t
. * controls take the household of their first interview in the estimation samp
> le.
. * Each person keeps one cluster for all years, so persons nest in clusters.
. * Panel: sa_first_birth_hhcluster_prepare_v1.do plus first_birth_model_bridge
> .py
. * (scratch, deleted after the run).
. version 17.0

. args panel outdir

. capture mkdir "`outdir'"

. tempname C R

. postfile `C' str12 run str8 window double estimate se_household using "`outdi
> r'/coef.dta", replace
(file
    /Users/tommasodesanto/Desktop/Projects/Fertility/Fertility_Spring26/code/
    > data/psid_followup_mar2026/output/sa_first_birth_hhcluster_2023/coef.dt
    > a not found)

. postfile `R' str12 run double observations persons clusters treated_ids contr
> ol_ids missing_hh_persons persons_sharing seconds using "`outdir'/receipt.dta
> ", replace
(file
    /Users/tommasodesanto/Desktop/Projects/Fertility/Fertility_Spring26/code/
    > data/psid_followup_mar2026/output/sa_first_birth_hhcluster_2023/receipt
    > .dta not found)

. foreach run in rooms_full own moved rooms_cs {
  2.     timer clear 2
  3.     timer on 2
  4.     use "`panel'", clear
  5.     local y = cond("`run'"=="rooms_cs" | "`run'"=="rooms_full", "rooms", "
> `run'")
  6.     keep if current & !missing(`y', AGEREP, EDUYEAR) & AGEREP >= 18 & !mis
> sing(iw) & iw > 0
  7.     gen double f_c_y = bio_first_year
  8.     drop if missing(f_c_y) & !(relchirep_max == 0)
  9.     drop if !missing(f_c_y) & f_c_y < year_entry_adult
 10.     gen byte control = missing(f_c_y) & relchirep_max == 0
 11.     gen byte hs_row = inlist(rel, 1, 2) & inrange(year - f_c_y, -3, -2)
 12.     bysort ID: egen byte hs_base = max(hs_row)
 13.     gen byte base_row = inrange(year - f_c_y, -3, -2)
 14.     bysort ID: egen byte has_base = max(base_row)
 15.     keep if control | (has_base & hs_base == 1)
 16.     drop hs_base base_row has_base
 17.     gen byte treated = !control & !missing(f_c_y)
 18.     if "`run'" == "rooms_cs" {
 19.         gen byte bad_f = treated & (missing(f_j) | f_j < 1 | f_j > fertili
> ty_last_index)
 20.         gen byte miss_model = missing(model_boundary_censored, model_bound
> ary_lifelong, model_age_censored)
 21.         drop if bad_f | miss_model
 22.         gen byte original_ref = treated & inrange(year - f_c_y, -3, -2)
 23.         bysort ID: egen byte id_original_ref = max(original_ref)
 24.         drop if treated & !id_original_ref
 25.     }
 26.     else {
 27.         * v2 cohort support: every treated cohort observed in the referenc
> e window.
.         gen byte in_ref = inrange(year - f_c_y, -3, -2)
 28.         bysort f_c_y: egen long ref_rows = total(in_ref)
 29.         drop if treated & ref_rows == 0
 30.     }
 31.     gen double K = year - f_c_y
 32.     gen byte Wleft = K <= -8 & !missing(K)
 33.     gen byte Wm2 = inrange(K, -7, -6)
 34.     gen byte Wm1 = inrange(K, -5, -4)
 35.     gen byte Wp1 = inrange(K, -1, 0)
 36.     gen byte Wp2 = inrange(K, 1, 2)
 37.     gen byte Wp3 = inrange(K, 3, 4)
 38.     gen byte Wp4 = inrange(K, 5, 6)
 39.     gen byte Wp5 = inrange(K, 7, 8)
 40.     gen byte Wp6 = inrange(K, 9, 10)
 41.     gen byte Wright = K >= 11 & !missing(K)
 42.     local dummies Wleft Wm2 Wm1 Wp1 Wp2 Wp3 Wp4 Wp5 Wp6 Wright
 43.     * Household cluster.
.     gen double hhkey = year * 100000 + hhid if !missing(hhid) & hhid > 0
 44.     gen double tref_row = year if treated & hs_row == 1 & !missing(hhkey)
 45.     bysort ID: egen double tref = min(tref_row)
 46.     gen double kref_row = hhkey if treated & year == tref
 47.     bysort ID: egen double hh_t = min(kref_row)
 48.     gen double tfirst_row = year if control & !missing(hhkey)
 49.     bysort ID: egen double tfirst = min(tfirst_row)
 50.     gen double kfirst_row = hhkey if control & year == tfirst
 51.     bysort ID: egen double hh_c = min(kfirst_row)
 52.     gen double hhc = cond(control, hh_c, hh_t)
 53.     egen byte ptag = tag(ID)
 54.     quietly count if ptag & missing(hhc)
 55.     local miss = r(N)
 56.     * Persons without a valid household id keep a cluster of their own.
.     replace hhc = -ID if missing(hhc)
 57.     bysort hhc: egen long npers = total(ptag)
 58.     quietly count if ptag & npers > 1
 59.     local sharing = r(N)
 60.     eventstudyinteract `y' `dummies' [pw=iw], vce(cluster hhc) absorb(ID y
> ear) ///
>         cohort(f_c_y) control_cohort(control) covariates(i.AGEREP i.EDUYEAR)
 61.     matrix b = e(b_iw)
 62.     matrix V = e(V_iw)
 63.     local n = e(N)
 64.     local nc = e(N_clust)
 65.     local names : colnames b
 66.     forvalues i = 1/`=colsof(b)' {
 67.         local w : word `i' of `names'
 68.         post `C' ("`run'") ("`w'") (b[1,`i']) (sqrt(V[`i',`i']))
 69.     }
 70.     egen byte ttag = tag(ID) if e(sample) & treated
 71.     quietly count if ttag
 72.     local tids = r(N)
 73.     egen byte ctag = tag(ID) if e(sample) & control
 74.     quietly count if ctag
 75.     local cids = r(N)
 76.     egen byte etag = tag(ID) if e(sample)
 77.     quietly count if etag
 78.     local pids = r(N)
 79.     timer off 2
 80.     quietly timer list 2
 81.     post `R' ("`run'") (`n') (`pids') (`nc') (`tids') (`cids') (`miss') (`
> sharing') (r(t2))
 82.     di "HHC_PASS `run' N=`n' clusters=`nc' Wp3=" b[1, colnumb("b","Wp3")]
 83. }
