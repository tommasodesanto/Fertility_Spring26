. foreach basis in rooms own moved moved_space moved_nbhd {
  2.     use `base', clear
  3.     keep if current & !missing(`basis', AGEREP, EDUYEAR) & AGEREP >= 18
  4.     keep if !missing(iw) & iw > 0
  5.     gen double f_c_y = bio_first_year
  6.     drop if missing(f_c_y) & !(relchirep_max == 0)
  7.     drop if !missing(f_c_y) & f_c_y < year_entry_adult
  8.     gen byte control = missing(f_c_y) & relchirep_max == 0
  9.     gen byte hs_row = inlist(rel,1,2) & inrange(year - f_c_y, -3, -2)
 10.     bysort ID: egen byte hs_base = max(hs_row)
 11.     gen byte base_row = inrange(year - f_c_y, -3, -2)
 12.     bysort ID: egen byte has_base = max(base_row)
 13.     keep if control | (has_base & hs_base == 1)
 14.     gen byte ref = !control & inrange(year - f_c_y, -3, -2)
 15.     if "`basis'" == "rooms" {
 16.         quietly count
 17.         local n_all = r(N)
 18.         egen byte pt = tag(ID)
 19.         quietly count if pt
 20.         local p_all = r(N)
 21.         quietly count if pt & control
 22.         local p_ctrl = r(N)
 23.         quietly count if pt & !control
 24.         local p_trt = r(N)
 25.         quietly summarize year
 26.         local y0 = r(min)
 27.         local y1 = r(max)
 28.         quietly summarize year if !control
 29.         local ty0 = r(min)
 30.         local ty1 = r(max)
 31.         quietly summarize bio_first_year if !control
 32.         local b0 = r(min)
 33.         local b1 = r(max)
 34.         di "SAMPLE rooms A2h: person-years=`n_all' persons=`p_all' treated
> =`p_trt' controls=`p_ctrl' years=`y0'-`y1' treated_years=`ty0'-`ty1' first_bi
> rth_years=`b0'-`b1'"
 35.         drop pt
 36.         _pctile age [aw=iw] if ref, p(5 95)
 37.         local a5 = r(r1)
 38.         local a95 = r(r2)
 39.         di "AGE_RANGE treated ref window p5=`a5' p95=`a95'"
 40.         local vars "rooms age edu woman svy"
 41.     }
 42.     else {
 43.         local vars "`basis'"
 44.     }
 45.     foreach v of local vars {
 46.         foreach g in parents_ref never_all never_agematch {
 47.             if "`g'" == "parents_ref" local cond "ref"
 48.             if "`g'" == "never_all" local cond "control"
 49.             if "`g'" == "never_agematch" local cond "control & inrange(age
> , `a5', `a95')"
 50.             quietly summarize `v' [aw=iw] if `cond'
 51.             local m = r(mean)
 52.             quietly count if `cond' & !missing(`v')
 53.             local r = r(N)
 54.             egen byte tg = tag(ID) if `cond' & !missing(`v')
 55.             quietly count if tg == 1
 56.             local p = r(N)
 57.             drop tg
 58.             post `P' ("`v'") ("`basis'") ("`g'") (`m') (`r') (`p')
 59.         }
 60.     }
 61.     di "DESC_PASS `basis'"
 62. }
