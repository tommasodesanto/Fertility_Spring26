+def test_full_renter_zero_wedge_matches_frozen_exactly() -> None:
+    args = _full_renter_fixture()
+    frozen = _frozen_full_renter_kernel().py_func(*args)
+    current = full_renter_block_kernel.py_func(*args, 0, 0.0, 0.0, 6.0)
+    assert all(np.array_equal(left, right) for left, right in zip(frozen, current))
