+def segment_enumerated_max(objective, lo, hi, bg):
+    """Global bounded search over every continuation-interpolation segment.
+
+    A single golden search over ``[lo, hi]`` is invalid when the continuation
+    is piecewise linear and the renter intratemporal problem has a knee or cap.
+    We therefore enumerate all intersected segments, retain both endpoints,
+    and run a high-precision bounded solve strictly inside each segment.
+    """
+    from scipy.optimize import minimize_scalar
+
+    lo, hi = float(lo), float(hi)
+    if not math.isfinite(lo) or not math.isfinite(hi) or hi < lo:
+        raise ValueError("invalid saving interval")
+    points = sorted({lo, hi} | {float(x) for x in np.asarray(bg).reshape(-1) if lo < float(x) < hi})
+
+    def checked_value(x):
+        value = float(objective(float(x)))
+        if not math.isfinite(value):
+            raise RuntimeError(f"saving oracle returned nonfinite value at endpoint/candidate {x}")
+        return value
+
+    best_x = points[0]
+    best_value = checked_value(best_x)
+    for left, right in zip(points[:-1], points[1:]):
+        for endpoint in (left, right):
+            value = checked_value(endpoint)
+            if value > best_value:
+                best_x, best_value = endpoint, value
+        if right - left <= 1e-14:
+            continue
+        result = minimize_scalar(
+            lambda x: -float(objective(float(x))),
+            bounds=(left, right),
+            method="bounded",
+            options={"xatol": 1e-12, "maxiter": 1000},
+        )
+        if not result.success or not math.isfinite(float(result.x)):
+            raise RuntimeError(f"segment bounded oracle failed: {result.message}")
+        candidate = float(result.x)
+        value = checked_value(candidate)
+        if value > best_value:
+            best_x, best_value = candidate, value
+    return best_x, best_value
+
