+def test_full_renter_wedge_highfloor_budget_edge() -> None:
+    args = _full_renter_fixture(resources=(15.0, 16.0, 20.0), hb=(10.0, 6.0))
+    python = full_renter_block_kernel.py_func(*args, 1, 0.0, 0.2, 6.0)
+    compiled = full_renter_block_kernel(*args, 1, 0.0, 0.2, 6.0)
+    assert np.all(np.isfinite(python[1])) and np.all(np.isfinite(python[2]))
+    # With no strictly positive residual housing, the wedge utility is a dead
+    # state; a finite positive-wedge allocation at hb == hRmax is invalid.
+    assert np.all(python[0][:, 0] <= -1e9)
+    resources, _, _, _, _, _, cb, _, _, _, _, _, rent, *_ = args
+    for i in range(resources.size):
+        if python[0][i, 0] <= -1e9:
+            continue
+        total_h = python[3][i, 0]
+        cost = total_h * (rent + 0.2 * max(total_h - 6.0, 0.0))
+        expenditure_gap = python[2][i, 0] + cost + python[1][i, 0] - resources[i]
+        assert expenditure_gap <= 1e-10
+        assert total_h <= 10.0 + 1e-12
+    assert all(np.allclose(left, right, atol=1e-11, rtol=0.0)
+               for left, right in zip(python, compiled))
