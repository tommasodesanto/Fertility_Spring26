+def test_segment_oracle_beats_global_golden_and_dense_grid() -> None:
+    """A narrow later peak must survive the piecewise-global audit."""
+    # The audit helper imports the dated policy module for its full driver.  A
+    # stub is sufficient here because this test exercises only its independent
+    # segment enumerator, without reconstructing a model state.
+    fake_policy = types.ModuleType("run_e5f_post2023_policy_mechanisms")
+    fake_policy.baseline = types.SimpleNamespace()
+    fake_policy.calendar = types.SimpleNamespace()
+    fake_policy.transition = types.SimpleNamespace()
+    sys.modules.setdefault("run_e5f_post2023_policy_mechanisms", fake_policy)
+    tools_dir = Path(__file__).resolve().parents[2] / "tools"
+    sys.path.insert(0, str(tools_dir))
+    import run_e5f_independent_numerical_audit as audit
+    from scipy.optimize import minimize_scalar
+
+    def objective(x: float) -> float:
+        x = float(x)
+        if x < 1.2:
+            return 1.0 - (x - 0.4) ** 2
+        return 10.0 - ((x - 1.9) / 0.005) ** 2
+
+    global_result = minimize_scalar(
+        lambda x: -objective(x), bounds=(0.0, 2.0), method="bounded",
+        options={"xatol": 1e-12, "maxiter": 1000},
+    )
+    optimum, value = audit.segment_enumerated_max(
+        objective, 0.0, 2.0, np.asarray([0.0, 1.2, 2.0])
+    )
+    dense_x = np.linspace(0.0, 2.0, 20001)
+    dense_lower_bound = max(objective(x) for x in dense_x)
+    assert value > -float(global_result.fun) + 1.0
+    assert value >= dense_lower_bound - 1e-8
+    assert 1.89 < optimum < 1.91
+
+    # Exercise the actual wedge objective wrapper with the same alpha and
+    # expenditure scale that the saving audit supplies to production states.
+    continuation = np.asarray([0.0, 6.0, 30.0])
+    wedge_args = dict(
+        lo=0.0, hi=2.0, resources=15.0, continuation=continuation,
+        bg=np.asarray([0.0, 1.2, 2.0]), rent=0.2, hb=5.0, cb=0.5,
+        pc=0.0, hmax=10.0, alpha=0.7, oms=0.5, beta=0.95, es=1.0,
+        w0=0.0, w1=0.2, hk=6.0,
+    )
+    wedge_x, wedge_value = audit.segment_oracle_wedge(**wedge_args)
+    wedge_values = [
+        float(np.asarray(audit.model.eval_renter_wedge(
+            x, wedge_args["resources"], continuation, wedge_args["bg"],
+            wedge_args["cb"], wedge_args["hb"], wedge_args["pc"],
+            wedge_args["rent"], wedge_args["hmax"], wedge_args["w0"],
+            wedge_args["w1"], wedge_args["hk"], wedge_args["alpha"],
+            wedge_args["oms"], wedge_args["beta"], es=wedge_args["es"],
+        )))
+        for x in np.linspace(wedge_args["lo"], wedge_args["hi"], 2001)
+    ]
+    assert np.isfinite(wedge_value)
+    assert wedge_value >= max(wedge_values) - 1e-8
+    assert wedge_args["lo"] <= wedge_x <= wedge_args["hi"]
+    with pytest.raises(RuntimeError, match="nonfinite"):
+        audit.segment_enumerated_max(lambda _x: float("nan"), 1.0, 1.0, np.asarray([1.0]))
